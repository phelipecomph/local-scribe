# Copy to .env and fill in. .env is gitignored.

# Where the .md note lands. Default = your Obsidian vault inbox.
# Linux:
VAULT_PATH=$HOME/Documents/obsidian-vault
# Windows (vault inside WSL2): use UNC path
# VAULT_PATH=\\wsl.localhost\Ubuntu\home\<user>\Documents\vault
NOTES_SUBDIR=inbox

# Whisper model: tiny | base | small | medium | large
# small ~ 466MB, decent PT-BR + EN, runs on CPU.
# medium is significantly better for English meetings with mixed audio.
WHISPER_MODEL=small

# Force Whisper to transcribe in a specific language (e.g. "en", "pt", "es").
# Leave empty for auto-detection. Set to "en" before English-only meetings if
# auto-detection is misidentifying the language (common with small model + noisy audio).
WHISPER_LANGUAGE=

# Language of the generated note (the summary written to your vault). This is the
# OUTPUT language and is independent of WHISPER_LANGUAGE (which only affects
# transcription). The summarization prompt instructs the model to write the whole
# note — section headings included — in this language.
#   pt -> Portuguese (Brazilian)   en -> English   es -> Spanish
# Any other value is passed through to the model verbatim as a language name.
OUTPUT_LANGUAGE=pt

# Claude model used for summarization.
CLAUDE_MODEL=claude-sonnet-4-6

# Which backend to use for summarization:
#   claude_cli     → shells out to `claude -p` (uses your Claude Code OAuth /
#                    Max subscription cap, no per-token billing).
#   anthropic_api  → calls the Anthropic API via the `anthropic` SDK
#                    (requires ANTHROPIC_API_KEY, billed per token).
SUMMARIZER_BACKEND=claude_cli
# Local LLM via Ollama (SUMMARIZER_BACKEND=ollama):
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434

# Path to claude CLI. Leave as 'claude' to use $PATH lookup.
# Linux: override if your install isn't on the GNOME-session PATH.
# Windows: if Claude Code is installed via npm, it should be on PATH. Otherwise use anthropic_api backend.
CLAUDE_BIN=claude

# Only needed when SUMMARIZER_BACKEND=anthropic_api.
ANTHROPIC_API_KEY=

# If set, WAV recordings are moved here after processing instead of deleted.
# Useful for testing pipeline changes without waiting for real meetings.
# Leave empty (or unset) to delete WAVs after successful summarization.
RECORDINGS_ARCHIVE_DIR=
